# ---------- Hedera (testnet only) ----------
# Operator account from portal.hedera.com (pays for account/topic creation, HCS messages)
HEDERA_OPERATOR_ID=0.0.xxxxx
HEDERA_OPERATOR_KEY=            # hex private key (ECDSA or ED25519) — never commit
HEDERA_NETWORK=hedera:testnet
# Merchant account that receives x402 payments (payTo). Defaults to operator if empty.
HEDERA_PAY_TO=
# Agent payer account (autonomous x402 payer). Created by scripts/hedera-setup.ts
AGENT_HEDERA_ID=
AGENT_HEDERA_KEY=
# x402 facilitator (listed in Hedera docs). Blocky402 testnet primary, x402.org backup.
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
# HCS audit topic id, created by scripts/hedera-setup.ts
HCS_TOPIC_ID=
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com

# ---------- Pricing (USD) ----------
PRICE_VERIFIED_USD=0.001
PRICE_UNVERIFIED_USD=0.02
# HBAR/USD rate used to convert USD prices to tinybars (testnet; documented constant)
HBAR_USD=0.05

# ---------- ENSv2 (Ethereum Sepolia) ----------
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ENS_DEPLOYER_KEY=               # Sepolia EOA private key (parent name owner) — never commit
ENS_PARENT_NAME=bouncer.eth     # .eth name we own on ENSv2 Sepolia
ENS_AGENT_REGISTRY=             # our PermissionedRegistry (UserRegistry proxy) for <human>.<parent>
ENS_UNIVERSAL_RESOLVER=0xeEeEEEeE14D718C2B47D9923Deab1335E144EeEe
# Agent signing key (the address its ENS name resolves to). Demo agent only.
AGENT_EVM_KEY=
AGENT_ENS_NAME=research.dev.bouncer.eth
POLICY_CACHE_MS=10000

# ---------- World ID Agent Pass (World IdP, OIDC) ----------
WORLD_ISSUER=https://auth.world.org
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=            # server only — never exposed to browser
WORLD_HUMAN_SALT=               # random 32 bytes hex; salts the per-human hash
STEPUP_TTL_SEC=120

# ---------- App ----------
PORT=4000
API_PUBLIC_URL=http://localhost:4000
DASHBOARD_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
